+ const seen=[];for(let i=0;i<6;i++){const item=await p.evaluate(()=>{const c=window.__flyerQA.current();return {layout:c.recipe.layout,apps:c.doc.capas.filter(p=>/^app[123]$/.test(p.rol)).map(p=>({role:p.rol,opacity:p.opacidad}))};});assert.equal(item.apps.length,3);assert.equal(new Set(item.apps.map(x=>x.role)).size,3);assert.ok(item.apps.every(x=>x.opacity===1));if(seen.length)assert.notEqual(item.layout,seen.at(-1));seen.push(item.layout);await p.locator('#ideaAgain').click();await p.waitForFunction(()=>!window.__flyerQA.state().loading);}
+ assert.equal(new Set(seen).size,6,'automatic cycle explores all six families before repeating');console.log('PASS real UI generates editable Salsa/Café/BuzzCast logos every time, opaque and deduplicated; no consecutive repeated layout',seen);
+ const layouts=await p.evaluate(()=>Object.keys(window.DivasFlyerLayouts.families));let n=0;
+ for(const format of ['1:1','9:16','16:9','banner'])for(const layout of layouts){const theme=n%3===0?'halloween':n%3===1?'divas':'gala',palette=n%3===0?'eclipse':n%3===1?'petalo':'oro',r=await p.evaluate(async a=>window.__flyerQA.sample(...a),[layout,format,theme,palette]);assert.equal(r.layers.filter(x=>/^app[123]$/.test(x.rol)).length,3);assert.equal(r.layers.filter(x=>x.rol==='titulo').length,1);assert.ok(r.layers.filter(x=>x.tipo==='texto').every(x=>Number.isFinite(x.tamano)&&x.tamano>0));
+ fs.writeFileSync(path.join(out,format.replace(':','x')+'-'+layout+'.png'),Buffer.from(r.image.split(',')[1],'base64'));if(format==='1:1'){const logos=await p.evaluate(a=>window.__flyerQA.resize(a,'9:16'),r.doc);assert.equal(logos.length,3);assert.ok(logos.every(x=>x.x-x.w/2>=0&&x.x+x.w/2<=1080&&x.y+x.h/2<=1920));}n++;}
