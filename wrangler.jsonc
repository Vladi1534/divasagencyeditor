{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "divasagencyeditor",
  "compatibility_date": "2026-10-23",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
